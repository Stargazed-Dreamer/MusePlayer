# Python 字节码与缓存
**/__pycache__/
*.py[cod]

# 虚拟环境与构建产物
.venv
.build
*.egg-info/

# 本地 agent 工具状态（不入库）
.workbuddy/

# 工具缓存
.ruff_cache/
.mypy_cache/
.pytest_cache/
.cache/

# 测试素材目录（音频文件、歌词等，不纳入版本控制）
test*
_library_test_*
# pytest 测试套件不属素材，显式再包含（否则 tests/ 下新增测试文件会被上面的通配静默忽略）
!tests/
!tests/**
# !tests/** 优先级高于顶部的 **/__pycache__/，此处重新屏蔽字节码缓存
tests/**/__pycache__/

# 日志文件
*.log

# Agent 配置（含密钥）
config.toml

# 运行时数据（JSON 持久化，运行时生成）
data/

# 临时文件与目录
temp/
output/
input/

# 根目录散落的调试/临时文件（不应入库，但本地保留使用）
crash.txt
todo.txt
*.muse_stats.json
对话存档.txt
*存档*.txt

# 临时工作文档
release_plan_draft.md

# 本地素材/图标（不入库，公开仓库不包含本地图片资源）
assets/
